#!/bin/bash
# Wird beim Systemstart als Benutzer "root" ausgefuehrt.
# LoxBerry benennt diese Datei bei der Installation in NAME um.
#
# Die Originalfassung startete hier den Bluetooth-Stapel von Hand: rsyslog-Regeln
# schreiben, hciuart.service bis zu dreimal neu starten, "hciconfig hci0 up"
# aufrufen und im Fehlerfall wiederholen - dazu zwei Endlosschleifen, die
# alle 15 Sekunden mit sed in /var/log/syslog und /var/log/kern.log
# herumschnitten. Das entfaellt vollstaendig: der Dienst schaltet den Adapter
# ueber die D-Bus-Eigenschaft "Powered" selbst ein, und hciconfig wird nicht
# mehr gebraucht.

pluginname=REPLACELBPPLUGINDIR
pluginbindir=REPLACELBPBINDIR
logdir=REPLACELBPLOGDIR
log=$logdir/ble_scanner_ng.log

if [ -x /usr/bin/logger ]; then
    /usr/bin/logger "loxberry-plugin-$pluginname - Starte BLE-Scanner NG"
fi

datadir=REPLACELBPDATADIR
piddatei=$datadir/dienst.pid

mkdir -p "$logdir" "$datadir" 2>/dev/null

# Der Dienst braucht keine Rootrechte: BlueZ erlaubt Mitgliedern der Gruppe
# bluetooth ueber D-Bus das Suchen. Deshalb als loxberry starten.
#
# Die Prozessnummer wird in dieselbe Datei geschrieben, die auch die
# Oberflaeche benutzt. Bis 1.1.0 fehlte das hier: nach einem Neustart des
# LoxBerry lief der Dienst, aber ohne PID-Datei - die Oberflaeche fiel dann
# auf die Suche nach dem Namen zurueck, und die trifft auch einen Editor, der
# ble_scanner_ng.py geoeffnet hat.
#
# echo $! muss INNERHALB der su-Zeichenkette stehen. Stuende es draussen,
# waere es die Nummer des su-Prozesses, nicht die des Dienstes - und der su
# beendet sich sofort.
su loxberry -c "nohup '$pluginbindir/ble_scanner_ng.py' >> '$log' 2>&1 & echo \$! > '$piddatei'" >/dev/null 2>&1

# Die Datei gehoert loxberry, damit die Oberflaeche sie spaeter aufraeumen kann.
chown loxberry:loxberry "$piddatei" 2>/dev/null

exit 0
