#!/bin/bash
# Wird beim Systemstart als Benutzer "root" ausgefuehrt.
# LoxBerry benennt diese Datei bei der Installation in NAME um.
#
# Die Originalfassung startete hier den Bluetooth-Stapel von Hand: rsyslog-Regeln
# schreiben, hciuart.service bis zu dreimal neu starten, "hciconfig hci0 up"
# aufrufen und im Fehlerfall wiederholen - dazu zwei Endlosschleifen, die
# alle 15 Sekunden mit sed in /var/log/syslog und /var/log/kern.log
# herumschnitten. Das entfaellt vollstaendig: der Dienst schaltet den Adapter
# ueber die D-Bus-Eigenschaft "Powered" selbst ein, und hciconfig wird nicht
# mehr gebraucht.

pluginname=REPLACELBPPLUGINDIR
pluginbindir=REPLACELBPBINDIR
logdir=REPLACELBPLOGDIR
log=$logdir/ble_scanner.log

if [ -x /usr/bin/logger ]; then
    /usr/bin/logger "loxberry-plugin-$pluginname - Starte BLE-Scanner"
fi

mkdir -p "$logdir" 2>/dev/null

# Der Dienst braucht keine Rootrechte: BlueZ erlaubt Mitgliedern der Gruppe
# bluetooth ueber D-Bus das Suchen. Deshalb als loxberry starten.
su loxberry -c "nohup $pluginbindir/ble_scanner.py >> $log 2>&1 &" >/dev/null 2>&1

exit 0
