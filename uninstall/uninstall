#!/bin/sh
#
# BLE-Scanner NG - Deinstallation
#
# LoxBerry entfernt die Verzeichnisse des Plugins selbst. Hier wird nur
# weggeraeumt, was AUSSERHALB davon liegt: der laufende Dienst, die Dateien
# auf der Ramdisk und die Zweitschrift der Konfiguration.

PTEMPDIR=$1
PSHNAME=$2
PDIR=$3
PVERSION=$4
# DIE WURZEL WIRD GESUCHT, NICHT GESETZT - Hausmuster aus REGELN_2.
#
# Hier stand ein fester Rueckfall auf das uebliche Installationsverzeichnis.
# Der Pluginpruefer von LoxBerry beanstandet ihn beim Einspielen ("HARDCODED
# PATH'S"), und er hat recht: LoxBerry laesst sich anderswohin installieren.
#
# Der naheliegende Ersatz - vom eigenen Ablageort aufwaerts suchen - braucht
# eine harte Obergrenze. Ohne sie laeuft die Suche bis zur Wurzel des
# Dateisystems durch und nimmt das erste Verzeichnis, das zufaellig
# config/plugins und data/plugins traegt; auf dem Entwicklungsrechner war das
# das Laufwerk selbst. Danach liefe "rm -f" gegen einen geratenen Baum.
lb_wurzel_suchen() {
    v=$(cd "$(dirname "$(readlink -f "$0")")" 2>/dev/null && pwd)
    i=0
    while [ -n "$v" ] && [ "$v" != "/" ] && [ $i -lt 8 ]; do
        if [ -d "$v/config/plugins" ] && [ -d "$v/data/plugins" ]; then
            echo "$v"
            return 0
        fi
        v=$(dirname "$v")
        i=$((i + 1))
    done
    return 1
}
BASE=${5:-$LBHOMEDIR}
if [ -z "$BASE" ] || [ ! -d "$BASE" ]; then
    BASE=$(lb_wurzel_suchen)
fi

# BERICHTIGT IN 1.3.0: hier stand PDIR="${3:-ble-scanner}". Das Plugin heisst
# ble_scanner_ng (plugin.cfg), und postinstall.sh sowie preupgrade.sh
# schrieben es richtig. Fehlte $3, zeigte der PID-Pfad ins Leere, das Skript
# meldete "Kein laufender Dienst gefunden" - eine Falschaussage - und der
# Dienst lief nach der Deinstallation weiter.
PDIR="${PDIR:-ble_scanner_ng}"

# Ohne Wurzel wird NICHTS angefasst, und es wird gesagt, was liegenbleibt.
# In der Zweitschrift stehen MAC-Adressen und die Klarnamen der ueberwachten
# Personen - ein stilles "fertig" waere hier besonders teuer.
if [ -z "$BASE" ]; then
    echo "<WARNING> Das Wurzelverzeichnis des LoxBerry war nicht zu ermitteln."
    echo "<WARNING> Diese Dateien bleiben deshalb LIEGEN und muessen von Hand weg:"
    echo "<WARNING>   <LoxBerry>/config/plugins/$PDIR.backup.ble_scanner_ng.cfg"
    echo "<WARNING>   <LoxBerry>/data/plugins/$PDIR.upgrade_sicherung"
    echo "<WARNING> In der ersten stehen MAC-Adressen und Klarnamen."
fi

PDATA="$BASE/data/plugins/$PDIR"
PIDDATEI="$PDATA/dienst.pid"

# --- Dienst beenden ---------------------------------------------------------
PID=""
if [ -f "$PIDDATEI" ]; then
    PID=$(cat "$PIDDATEI" 2>/dev/null)
fi
# Gegenprobe: gehoert die Nummer wirklich unserem Dienst? Eine Nummer wird
# nach dem Ende eines Prozesses wiederverwendet.
if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
    if ! tr '\0' '\n' < "/proc/$PID/cmdline" 2>/dev/null | grep -q "ble_scanner_ng\.py"; then
        PID=""
    fi
fi
if [ -z "$PID" ]; then
    for d in /proc/[0-9]*; do
        [ -r "$d/cmdline" ] || continue
        if tr '\0' '\n' < "$d/cmdline" 2>/dev/null | grep -q "ble_scanner_ng\.py"; then
            PID=$(basename "$d")
            break
        fi
    done
fi

beendet=0
if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
    echo "<INFO> Halte den BLE-Scanner NG an (PID $PID)."
    kill "$PID" 2>/dev/null
    i=0
    while [ $i -lt 15 ] && kill -0 "$PID" 2>/dev/null; do
        sleep 1
        i=$((i + 1))
    done
    # kill -9 NUR, wenn der Prozess noch laeuft UND immer noch unserer ist.
    # Bis 1.2.10 folgte das -9 bedingungslos - auch wenn der Prozess laengst
    # beendet war und die Nummer inzwischen ein fremder Prozess trug.
    if kill -0 "$PID" 2>/dev/null \
       && tr '\0' '\n' < "/proc/$PID/cmdline" 2>/dev/null | grep -q "ble_scanner_ng\.py"; then
        echo "<WARNING> Der Dienst reagierte nicht auf SIGTERM - er wird abgeschossen."
        kill -9 "$PID" 2>/dev/null
    fi
    beendet=1
    rm -f "$PIDDATEI"
fi

if [ "$beendet" = "1" ]; then
    echo "<OK> Dienst beendet."
else
    echo "<INFO> Kein laufender Dienst gefunden."
fi

# --- Nur die EIGENEN Dateien wegraeumen -------------------------------------
#
# Bis 1.1.0 loeschte diese Stelle auch /tmp/BLE-Scanner.loglevel und
# /tmp/BLE-Scanner.daemon.pid - Rueckstaende der ORIGINALFASSUNG, deren
# Plugin-Name "BLE-Scanner" lautete. Das war richtig, solange diese
# Fortfuehrung dieselbe Kennung trug und das Original ersetzte. Seit 1.2.1
# ist es ein eigenstaendiges Plugin, das neben dem Original laufen kann:
# dessen Dateien mitzunehmen wuerde eine fremde, weiterlaufende Installation
# beschaedigen.
rm -f /run/shm/ble_scanner_ng_status.json /tmp/ble_scanner_ng_status.json
rm -f /run/shm/ble_scanner_ng_steuer.json /tmp/ble_scanner_ng_steuer.json
rm -f /tmp/ble_scanner_ng.loglevel /tmp/ble_scanner_ng.daemon.pid

# --- Die Zweitschrift der Konfiguration -------------------------------------
#
# NEU IN 1.3.0. Sie liegt AUSSERHALB des Plugin-Ordners
# (config/plugins/<pdir>.backup.ble_scanner_ng.cfg) und wurde deshalb von
# LoxBerry nicht mit entfernt. Zwei Folgen hatte das: eine Datei mit
# MAC-Adressen und den Klarnamen der ueberwachten Personen blieb dauerhaft
# auf dem Geraet liegen, und bei einer spaeteren Neuinstallation spielte
# postinstall.sh sie UNGEFRAGT wieder ein - der Anwender bekam seine alte
# Personenliste zurueck, ohne danach gefragt worden zu sein.
ZWEIT="$BASE/config/plugins/$PDIR.backup.ble_scanner_ng.cfg"
if [ -f "$ZWEIT" ]; then
    rm -f "$ZWEIT" && echo "<OK> Zweitschrift der Konfiguration entfernt ($ZWEIT)."
fi

echo "<INFO> Die Themen im MQTT-Broker bleiben stehen. Wer sie loswerden will,"
echo "<INFO> loescht sie dort - ein zurueckbehaltenes Thema verschwindet nur"
echo "<INFO> durch eine Nachricht mit leerer Nutzlast."


# ---------- Den Nachbarn der Sicherung wegraeumen ----------
# data/plugins/<ordner>.upgrade_sicherung liegt AUSSERHALB des Ordners, den
# LoxBerry beim Deinstallieren loescht - genau deshalb uebersteht er ein
# Update. Wer ihn hier nicht abraeumt, laesst Zugangsdaten liegen.
# EINE Wurzel und EIN Ordnername - beide stehen oben.
#
# Hier standen bis 1.3.5 eigene Variablen daneben: UN_BASE ohne jeden
# Rueckfall und UN_FOLDER ohne den Vorgabewert, den PDIR weiter oben laengst
# hat. Fehlten die Argumente, tat dieser Block still nichts, waehrend der Rest
# der Datei sehr wohl arbeitete - zwei Wahrheiten ueber dieselbe Sache in
# einer Datei.
if [ -n "$BASE" ] && [ -d "$BASE/data/plugins" ]; then
    rm -rf "$BASE/data/plugins/$PDIR.upgrade_sicherung" 2>/dev/null
fi
exit 0
