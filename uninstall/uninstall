#!/bin/sh
#
# BLE-Scanner NG - Deinstallation
#
# LoxBerry entfernt die Verzeichnisse des Plugins selbst. Hier wird nur
# weggeraeumt, was AUSSERHALB davon liegt: der laufende Dienst, die Dateien
# auf der Ramdisk und die Zweitschrift der Konfiguration.

PTEMPDIR=$1   # NICHT der Auspackordner: $1 ist eine zehnstellige Zufallskennung; der Ordner steht in $6
              # bzw. im Arbeitsverzeichnis (Regeln/06 Z. 276-277; Gruppe 13, E4). Unbenutzt.
PSHNAME=$2
PDIR=$3
PVERSION=$4
# DIE WURZEL WIRD GESUCHT, NICHT GESETZT - Hausmuster aus REGELN_2.
#
# Hier stand ein fester Rueckfall auf das uebliche Installationsverzeichnis.
# Der Pluginpruefer von LoxBerry beanstandet ihn beim Einspielen ("HARDCODED
# PATH'S"), und er hat recht: LoxBerry laesst sich anderswohin installieren.
#
# Der naheliegende Ersatz - vom eigenen Ablageort aufwaerts suchen - braucht
# eine harte Obergrenze. Ohne sie laeuft die Suche bis zur Wurzel des
# Dateisystems durch und nimmt das erste Verzeichnis, das zufaellig
# config/plugins und data/plugins traegt; auf dem Entwicklungsrechner war das
# das Laufwerk selbst. Danach liefe "rm -f" gegen einen geratenen Baum.
#
# BERICHTIGT IN 1.3.19: die Suche verlangt jetzt auch
# config/system/general.json. Bis 1.3.18 genuegten config/plugins und
# data/plugins - genau die hinterlaesst ein Pruefstand; in WSL gemessen
# (Pruefung-BLE-Scanner-1.3.19, Fall U4): in einem fremden Baum ohne
# general.json wurde die Zweitschrift dieses Baums geloescht. Ein genanntes
# $5 oder LBHOMEDIR gilt nur mit config/plugins und data/plugins darunter.
lb_wurzel_suchen() {
    v=$(cd "$(dirname "$(readlink -f "$0")")" 2>/dev/null && pwd)
    i=0
    while [ -n "$v" ] && [ "$v" != "/" ] && [ $i -lt 8 ]; do
        if [ -d "$v/config/plugins" ] && [ -d "$v/data/plugins" ] \
           && [ -f "$v/config/system/general.json" ]; then
            echo "$v"
            return 0
        fi
        v=$(dirname "$v")
        i=$((i + 1))
    done
    return 1
}
BASE=${5:-$LBHOMEDIR}
if [ -z "$BASE" ] || [ ! -d "$BASE/config/plugins" ] || [ ! -d "$BASE/data/plugins" ]; then
    BASE=$(lb_wurzel_suchen)
fi

# BERICHTIGT IN 1.3.0: hier stand PDIR="${3:-ble-scanner}". Das Plugin heisst
# ble_scanner_ng (plugin.cfg), und postinstall.sh sowie preupgrade.sh
# schrieben es richtig. Fehlte $3, zeigte der PID-Pfad ins Leere, das Skript
# meldete "Kein laufender Dienst gefunden" - eine Falschaussage - und der
# Dienst lief nach der Deinstallation weiter.
PDIR="${PDIR:-ble_scanner_ng}"
# B7 (Gruppe 13): ein Ordnername mit "/" oder ".." - nichts anfassen (wie preinstall.sh).
case "$PDIR" in
    ''|*/*|*..*) echo "<WARNING> Unzulaessiger Ordnername '$PDIR' - nichts entfernt."; exit 0 ;;
esac

# Ohne Wurzel wird NICHTS angefasst, und es wird gesagt, was liegenbleibt.
# In der Zweitschrift stehen MAC-Adressen und die Klarnamen der ueberwachten
# Personen - ein stilles "fertig" waere hier besonders teuer.
if [ -z "$BASE" ]; then
    echo "<WARNING> Das Wurzelverzeichnis des LoxBerry war nicht zu ermitteln."
    echo "<WARNING> Diese Dateien bleiben deshalb LIEGEN und muessen von Hand weg:"
    echo "<WARNING>   <LoxBerry>/config/plugins/$PDIR.backup.ble_scanner_ng.cfg"
    echo "<WARNING>   <LoxBerry>/data/plugins/$PDIR.upgrade_sicherung"
    echo "<WARNING> In der ersten stehen MAC-Adressen und Klarnamen."
    # SEIT 1.3.19 wird danach NICHTS mehr getan. Bis 1.3.18 lief das Skript
    # nach dieser Warnung weiter, mit Pfaden ab der Laufwerkswurzel
    # ("/data/plugins/..."). Der Dienst, die Ramdisk-Dateien und die Themen
    # im Broker gehoeren zu einer Installation, die hier niemand kennt.
    echo "<WARNING> Der Dienst wurde nicht angehalten, und die zurueckbehaltenen"
    echo "<WARNING> MQTT-Themen der Linie wurden nicht geleert."
    exit 0
fi

PDATA="$BASE/data/plugins/$PDIR"
PIDDATEI="$PDATA/dienst.pid"

# --- Gemeinsame Hilfen (Gruppe 13, V9): bin/bl_haken.sh ---------------------------------------
# Fehlt die Datei oder ist sie defekt: Warnung und eine Minimalform (nur nach der PID-Datei) - keine stille
# Luecke, aber auch kein Abbruch.
BLH="$BASE/bin/plugins/$PDIR/bl_haken.sh"
if [ -f "$BLH" ] && sh -n "$BLH" 2>/dev/null && grep -qx 'BL_HAKEN_FASSUNG=1' "$BLH" 2>/dev/null; then
    BL_HAKEN_LADEN=1
    . "$BLH"
else
    echo "<WARNING> Die gemeinsamen Hilfen $BLH fehlen oder sind defekt - es gilt die Minimalform (PID-Datei)."
    bl_dienste_finden() {
        bl_p=$(cat "$PIDDATEI" 2>/dev/null)
        case "$bl_p" in ''|*[!0-9]*) return 0 ;; esac
        grep -qaF "$1" "/proc/$bl_p/cmdline" 2>/dev/null && echo "$bl_p"
        return 0
    }
    bl_dienste_beenden() {
        BL_UEBRIG=""
        bl_pids=$(bl_dienste_finden "$1" "$2")
        BL_GEFUNDEN=$(echo $bl_pids | wc -w | tr -d ' ')
        [ -n "$bl_pids" ] && kill $bl_pids 2>/dev/null && sleep 2
        BL_UEBRIG=$(bl_dienste_finden "$1" "$2")
    }
fi


# Die Befehlsbruecke (seit 1.3.28, Gruppe 13; Bauart Dashboard 0.9.37). Erst befehlsbruecke.sh stop, dann nachzaehlen: ein Bruecken-Dienst
# dieses Ordners (php, genau zwei Argumente, argv[1] der eigene Pfad) und ein mosquitto_sub mit der eigenen
# Optionsdatei werden hart beendet. Die Optionsdateien tragen das Broker-Kennwort - vor dem Loeschen ueberschreiben,
# dann den Ordner befehle/ entfernen. Im Broker bleibt
# nichts: Quittungen und status/befehle sind nie retained. Bauart Sprachsteuerung 0.12.7.
UN_PBIN="$BASE/bin/plugins/$PDIR"
UN_PBIN_P=$(cd "$UN_PBIN" 2>/dev/null && pwd -P)
BBSH="$UN_PBIN/befehlsbruecke.sh"
BBPHP="$UN_PBIN/befehlsbruecke.php"
BBDIR="$BASE/data/plugins/$PDIR/befehle"
if [ -f "$BBSH" ] && command -v bash >/dev/null 2>&1; then
    echo "<INFO> Befehlsbruecke: $(timeout 40 bash "$BBSH" stop 2>&1 9>&- | head -n 1)"
fi
BB_REST=0
for bb_d in /proc/[0-9]*; do
    grep -qaF "befehlsbruecke.php" "$bb_d/cmdline" 2>/dev/null || continue
    bb_a0=$(tr '\0' '\n' < "$bb_d/cmdline" 2>/dev/null | sed -n 1p)
    bb_a1=$(tr '\0' '\n' < "$bb_d/cmdline" 2>/dev/null | sed -n 2p)
    bb_n=$(tr '\0' '\n' < "$bb_d/cmdline" 2>/dev/null | grep -c '')
    case "${bb_a0##*/}" in php|php[0-9]*) ;; *) continue ;; esac
    if [ "$bb_n" = 2 ] && { [ "$bb_a1" = "$BBPHP" ] || { [ -n "$UN_PBIN_P" ] && [ "$bb_a1" = "$UN_PBIN_P/befehlsbruecke.php" ]; }; }; then
        kill -9 "${bb_d#/proc/}" 2>/dev/null && BB_REST=$((BB_REST + 1))
    fi
done
BB_ABOS=0
for bb_d in /proc/[0-9]*; do
    [ "$(cat "$bb_d/comm" 2>/dev/null)" = "mosquitto_sub" ] || continue
    if tr '\0' '\n' < "$bb_d/environ" 2>/dev/null | grep -qxF "XDG_CONFIG_HOME=$BBDIR/mosquitto"; then
        kill -9 "${bb_d#/proc/}" 2>/dev/null && BB_ABOS=$((BB_ABOS + 1))
    fi
done
[ "$BB_REST" -gt 0 ] && echo "<WARNING> Befehlsbruecke: $BB_REST Dienst(e) erst mit kill -9 beendet."
[ "$BB_ABOS" -gt 0 ] && echo "<WARNING> Befehlsbruecke: $BB_ABOS mosquitto_sub erst mit kill -9 beendet."
if [ -d "$BBDIR" ] && [ ! -L "$BBDIR" ]; then
    for bb_f in "$BBDIR/mosquitto/mosquitto_sub" "$BBDIR/mosquitto/mosquitto_pub"; do
        if [ -f "$bb_f" ] && [ ! -L "$bb_f" ]; then
            bb_n=$(stat -c %s "$bb_f" 2>/dev/null || echo 64)
            head -c "$bb_n" /dev/zero > "$bb_f" 2>/dev/null
        fi
    done
    case "$BBDIR" in
        */data/plugins/?*/befehle) rm -rf "${BBDIR:?}" ;;
    esac
fi
if [ -e "$BBDIR/mosquitto/mosquitto_sub" ] || [ -e "$BBDIR/mosquitto/mosquitto_pub" ]; then
    echo "<WARNING> Befehlsbruecke: Optionsdateien liegen noch unter $BBDIR/mosquitto - von Hand entfernen."
fi

# --- Dienst beenden ---------------------------------------------------------
#
# bl_dienste_finden() und bl_dienste_beenden() steht seit 1.3.28 in bin/bl_haken.sh (Gruppe 13, V9; oben eingebunden) - bis 1.3.27 wortgleich in
# mehreren Hakenskripten.

# Die Deinstallation laeuft als root, der Dienst als loxberry: nur Prozesse von
# loxberry. Gibt es den Benutzer nicht, wird NICHT geraten - dann bleibt der
# Dienst stehen, und es wird gesagt.
BL_UID=$(id -u loxberry 2>/dev/null)
if [ -z "$BL_UID" ]; then
    echo "<WARNING> Benutzer loxberry nicht gefunden - der Dienst wurde nicht gesucht."
else
    bl_dienste_beenden "$BASE/bin/plugins/$PDIR/ble_scanner_ng.py" "$BL_UID"
    if [ -n "$BL_UEBRIG" ]; then
        echo "<WARNING> Der Dienst laesst sich nicht beenden (PID$BL_UEBRIG)."
    elif [ "$BL_GEFUNDEN" != 0 ]; then
        echo "<OK> Dienst beendet ($BL_GEFUNDEN Prozess(e))."
    else
        echo "<INFO> Kein laufender Dienst gefunden."
    fi
fi
rm -f "$PIDDATEI"

# --- Die zurueckbehaltenen MQTT-Themen der Linie leeren ----------------------
#
# NEU IN 1.3.19. Bis 1.3.18 stand hier nur ein Hinweis, die Themen blieben
# stehen. Regeln/07 (entschieden am 18.09.2026) erlaubt den retained Letzten
# Willen server/online nur, wenn die Deinstallation das Thema abraeumt - sonst
# bliebe die 0 eines entfernten Plugins fuer immer stehen. Geleert werden alle
# retained Themen dieser Linie unter dem Praefix aus der Konfiguration, auch
# Altwerte aus Vorfassungen, und hinterher wird beim Broker nachgelesen
# (ble_scanner_ng.py mqtt_leeren()). Ein fremdes Thema und die Themen eines
# anderen Scanners unter demselben Praefix bleiben stehen. Der Dienst ist oben
# schon beendet - sonst schriebe er gleich wieder hinein.
#
# 'timeout -k 5 60': ohne -k schickt timeout nach 60 s nur SIGTERM, und ein
# Programm, das es nicht annimmt, hielte die Deinstallation an (Muster 13 der
# Nachlese, Vorbild Weissware 0.9.34). Nach 60 s SIGTERM, nach weiteren 5 s
# SIGKILL, und der Abbruch steht als WARNING da. In WSL gemessen
# (Pruefung-BLE-Scanner-1.3.19, Fall U3).
#
# Ein Einmallauf mit drei Argumenten - die Diensterkennung oben zaehlt ihn nie
# als Dienst. Rueckgabe 0-2 meldet ble_scanner_ng.py selbst.
bl_in_hochkomma() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}
BL_SKRIPT="$BASE/bin/plugins/$PDIR/ble_scanner_ng.py"
BL_RC=0
if [ -f "$BL_SKRIPT" ] && command -v python3 >/dev/null 2>&1; then
    if [ "$(id -u)" = "0" ] && [ -n "$BL_UID" ]; then
        su -s /bin/sh loxberry -c "env PYTHONDONTWRITEBYTECODE=1 timeout -k 5 60 python3 $(bl_in_hochkomma "$BL_SKRIPT") --mqtt-leeren" \
            < /dev/null 2>&1 || BL_RC=$?
    else
        env PYTHONDONTWRITEBYTECODE=1 timeout -k 5 60 python3 "$BL_SKRIPT" --mqtt-leeren \
            < /dev/null 2>&1 || BL_RC=$?
    fi
    case "$BL_RC" in
        0|1|2) ;;
        124) echo "<WARNING> MQTT: das Leeren der zurueckbehaltenen Themen wurde nach 60 s abgebrochen - unter dem Praefix der Linie kann noch etwas im Broker stehen. Von Hand: mosquitto_pub -r -n -t <thema>" ;;
        137) echo "<WARNING> MQTT: das Leeren der zurueckbehaltenen Themen reagierte nach 60 s nicht auf SIGTERM und wurde hart beendet (SIGKILL) - unter dem Praefix der Linie kann noch etwas im Broker stehen. Von Hand: mosquitto_pub -r -n -t <thema>" ;;
        *) echo "<WARNING> MQTT: das Leeren der zurueckbehaltenen Themen endete unerwartet (Rueckgabe $BL_RC) - unter dem Praefix der Linie kann noch etwas im Broker stehen." ;;
    esac
else
    echo "<INFO> python3 oder $BL_SKRIPT fehlt - zurueckbehaltene MQTT-Themen wurden nicht geleert."
fi

# --- Nur die EIGENEN Dateien wegraeumen -------------------------------------
#
# Bis 1.1.0 loeschte diese Stelle auch /tmp/BLE-Scanner.loglevel und
# /tmp/BLE-Scanner.daemon.pid - Rueckstaende der ORIGINALFASSUNG, deren
# Plugin-Name "BLE-Scanner" lautete. Das war richtig, solange diese
# Fortfuehrung dieselbe Kennung trug und das Original ersetzte. Seit 1.2.1
# ist es ein eigenstaendiges Plugin, das neben dem Original laufen kann:
# dessen Dateien mitzunehmen wuerde eine fremde, weiterlaufende Installation
# beschaedigen.
#
# Seit 1.3.19 tragen Abbild und Auftragsdatei den Ordnernamen. Die Dateien
# unter dem alten, festen Namen gehoeren dieser Installation nur, wenn sie
# selbst ble_scanner_ng heisst oder es keine Installation dieses Namens gibt -
# sonst gehoeren sie der Erstinstallation und bleiben liegen (Fall Z7).
BL_RAM=$(printf '%s' "$PDIR" | tr -c 'A-Za-z0-9_-' '_')
BL_ALT_EIGEN=0
if [ "$BL_RAM" = "ble_scanner_ng" ] || [ ! -d "$BASE/config/plugins/ble_scanner_ng" ]; then
    BL_ALT_EIGEN=1
fi
for bl_ort in /run/shm /tmp; do
    rm -f "$bl_ort/${BL_RAM}_status.json" "$bl_ort/${BL_RAM}_status.json.tmp" "$bl_ort/${BL_RAM}_steuer.json"
    if [ "$BL_ALT_EIGEN" = 1 ]; then
        rm -f "$bl_ort/ble_scanner_ng_status.json" "$bl_ort/ble_scanner_ng_status.json.tmp"               "$bl_ort/ble_scanner_ng_steuer.json"
    fi
done
rm -f /tmp/ble_scanner_ng.loglevel /tmp/ble_scanner_ng.daemon.pid

# --- Die Zweitschrift der Konfiguration -------------------------------------
#
# NEU IN 1.3.0. Sie liegt AUSSERHALB des Plugin-Ordners
# (config/plugins/<pdir>.backup.ble_scanner_ng.cfg) und wurde deshalb von
# LoxBerry nicht mit entfernt. Zwei Folgen hatte das: eine Datei mit
# MAC-Adressen und den Klarnamen der ueberwachten Personen blieb dauerhaft
# auf dem Geraet liegen, und bei einer spaeteren Neuinstallation spielte
# postinstall.sh sie UNGEFRAGT wieder ein - der Anwender bekam seine alte
# Personenliste zurueck, ohne danach gefragt worden zu sein.
ZWEIT="$BASE/config/plugins/$PDIR.backup.ble_scanner_ng.cfg"
if [ -f "$ZWEIT" ]; then
    rm -f "$ZWEIT" && echo "<OK> Zweitschrift der Konfiguration entfernt ($ZWEIT)."
fi
# V1 (Gruppe 13): die Zweitschrift von irk.json (Identitaetsschluessel) ebenso.
ZWEIT_IRK="$BASE/config/plugins/$PDIR.backup.irk.json"
if [ -f "$ZWEIT_IRK" ]; then
    rm -f "$ZWEIT_IRK" && echo "<OK> Zweitschrift der IRK-Schluessel entfernt ($ZWEIT_IRK)."
fi

# --- Der Helfer fuer das Einschalten von Bluetooth --------------------------
#
# postroot.sh hat ihn nach /usr/local/sbin gelegt - AUSSERHALB des
# Plugin-Ordners, den LoxBerry selbst abraeumt. Die sudo-Regel
# (<home>/system/sudoers/ble_scanner_ng) entfernt LoxBerry selbst
# (plugininstall.pl, Zeile 1609); dieser Helfer bleibt sonst liegen.
#
# WARUM DAS NICHT EGAL IST: liegenbleibende Datei plus entfernte Regel ist
# harmlos, liegenbleibende Datei plus spaeter anders vergebene Regel nicht.
# Eine Datei in /usr/local/sbin, die root gehoert und niemandem mehr dient,
# gehoert weg.
#
# Laeuft dieses Skript nicht als root, misslingt das rm - dann wird es gesagt
# statt verschwiegen.
# B23 (Gruppe 13): steht noch eine zweite Installation (config/plugins/ble_scanner_ng*), bleibt der Helfer fuer
# sie liegen - ihre sudo-Regel faellt beim Deinstallieren zwar mit (gleicher NAME), kommt aber mit ihrem naechsten
# Einspielen wieder, und dann braucht sie den Helfer.
HELFER=/usr/local/sbin/ble_scanner_ng_bluetooth
BL_ANDERE=""
for bl_o in "$BASE"/config/plugins/ble_scanner_ng*; do
    [ -d "$bl_o" ] || continue
    [ "${bl_o##*/}" = "$PDIR" ] && continue
    BL_ANDERE="${bl_o##*/}"
done
if [ -f "$HELFER" ] && [ -n "$BL_ANDERE" ]; then
    echo "<INFO> Helfer bleibt fuer $BL_ANDERE ($HELFER); nach dessen naechstem Einspielen ist die Regel wieder da."
elif [ -f "$HELFER" ]; then
    if rm -f "$HELFER" 2>/dev/null && [ ! -f "$HELFER" ]; then
        echo "<OK> Helfer fuer Bluetooth entfernt ($HELFER)."
    else
        echo "<WARNING> $HELFER liess sich nicht entfernen - von Hand als root:"
        echo "<WARNING>   rm -f $HELFER"
    fi
fi

# Eingeschaltet gelassenes Bluetooth wird NICHT wieder abgeschaltet: ob der
# Adapter laufen soll, entscheidet das System und nicht dieses Plugin - und
# ein anderes Plugin koennte ihn inzwischen benutzen.


# ---------- Den Nachbarn der Sicherung wegraeumen ----------
# data/plugins/<ordner>.upgrade_sicherung liegt AUSSERHALB des Ordners, den
# LoxBerry beim Deinstallieren loescht - genau deshalb uebersteht er ein
# Update. Wer ihn hier nicht abraeumt, laesst Zugangsdaten liegen.
# EINE Wurzel und EIN Ordnername - beide stehen oben.
#
# Hier standen bis 1.3.5 eigene Variablen daneben: UN_BASE ohne jeden
# Rueckfall und UN_FOLDER ohne den Vorgabewert, den PDIR weiter oben laengst
# hat. Fehlten die Argumente, tat dieser Block still nichts, waehrend der Rest
# der Datei sehr wohl arbeitete - zwei Wahrheiten ueber dieselbe Sache in
# einer Datei.
if [ -n "$BASE" ] && [ -d "$BASE/data/plugins" ]; then
    rm -rf "$BASE/data/plugins/$PDIR.upgrade_sicherung" 2>/dev/null
    # ERGAENZT IN 1.3.17. Die beiden Merker aus preupgrade.sh liegen aus
    # demselben Grund NEBEN dem Datenordner und ueberstehen deshalb auch das
    # Loeschen durch LoxBerry. Bis 1.3.16 blieben sie liegen: eine spaetere
    # Neuinstallation fand eine fremde ".upgrade_laeuft" vor, und seit 1.3.17
    # sieht daemon/daemon sie an. Vierter Punkt der Bauweise Einspeisebremse
    # 0.9.20 (Regeln/06) - "uninstall raeumt sie weg".
    rm -f "$BASE/data/plugins/$PDIR.upgrade_laeuft" 2>/dev/null
    rm -f "$BASE/data/plugins/$PDIR.lief_vor_update" 2>/dev/null
    # ERGAENZT IN 1.3.20 (Pruefung 29.09.2026, B5): der Sollmerker und die
    # Datei des Waechters (cron/cron.05min) liegen aus demselben Grund neben
    # dem Datenordner. Blieben sie liegen, hielte ein "0" aus dieser
    # Installation eine spaetere an.
    rm -f "$BASE/data/plugins/$PDIR.soll_laufen" 2>/dev/null
    # Merkliste der eigenen Haus-Themen (Gruppe 13): --mqtt-leeren hat sie oben abgeraeumt und nachgelesen.
    rm -f "$BASE/data/plugins/$PDIR.haus_themen" "$BASE/data/plugins/$PDIR.haus_themen.neu" 2>/dev/null
    rm -f "$BASE/data/plugins/$PDIR.waechter" "$BASE/data/plugins/$PDIR.waechter.neu."* 2>/dev/null
fi

# ---------- .alt, .vorher, .kaputt und Reste abgebrochener Laeufe ----------
# NEU IN 1.3.20, aus dem gegengemessenen Vorschlag des Installer-Pruefers
# (Durchgang 29.09.2026, B5; in WSL Fall U1: bis dahin blieben vier Dateien
# mit der Personenliste liegen). preinstall.sh legt bei einer
# Neuinstallation .alt ab (Entscheidung 1), preupgrade.sh eine Sicherung aus
# einem frueheren Lauf nach .vorher, postupgrade.sh eine unvollstaendige
# Konfiguration nach .kaputt, und ein abgebrochenes preupgrade.sh hinterlaesst
# .neu/.alt neben Zweitschrift und Sicherung. Alle tragen MAC-Adressen und
# Namen. Jeder Rest wird einzeln gemeldet.
if [ -n "$BASE" ] && [ -d "$BASE/data/plugins" ]; then
    for bl_rest in "$ZWEIT.alt" "$ZWEIT.neu" \
                   "$BASE/data/plugins/$PDIR.upgrade_sicherung.alt" \
                   "$BASE/data/plugins/$PDIR.upgrade_sicherung.neu" \
                   "$BASE/data/plugins/$PDIR.upgrade_sicherung.vorher" \
                   "$BASE/data/plugins/$PDIR.upgrade_sicherung.kaputt"; do
        if [ -e "$bl_rest" ] || [ -L "$bl_rest" ]; then
            rm -rf "$bl_rest" 2>/dev/null
            if [ -e "$bl_rest" ] || [ -L "$bl_rest" ]; then
                echo "<WARNING> $bl_rest liess sich nicht entfernen - bitte von Hand."
            else
                echo "<OK> Rest einer frueheren Sicherung entfernt ($bl_rest)."
            fi
        fi
    done
fi
exit 0
